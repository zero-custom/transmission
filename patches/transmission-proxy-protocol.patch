+    {
+        auto line = std::string{ "PROXY TCP4 " };
+        line += src_ip;
+        line += ' ';
+        line += dst_ip;
+        line += ' ';
+        line += std::to_string(src_port);
+        line += ' ';
+        line += std::to_string(dst_port);
+        line += "\r\n";
+        return toBytes(line);
